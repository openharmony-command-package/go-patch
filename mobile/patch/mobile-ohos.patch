+    while (*link != s)
+      link = &(*link)->nextState;
+    *link = s->nextState;
+    pthread_mutex_unlock(&oh_lock);
+    gomobileOHOSClose(s->owner);
+    free(s);
+    return fail(env, "cannot create callback dispatcher");
+  }
+  napi_unref_threadsafe_function(env, s->tsfn);
+  napi_add_env_cleanup_hook(env, cleanup, s);
