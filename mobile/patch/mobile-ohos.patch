+// Internal N-API transport. Applications import the generated HAR API.
+export interface NativeBridge {
+ call(operation: string,args: string): Promise<string>;
+ own(id: number): object;
+ unwrap(token: object): number;
+ dispose(token: object): void;
+ registerCallback(callback: (method: string,args: string)=>Promise<string>): number;
+ dropCallback(id: number): void;
+ collect(): void;
+}
+declare const bridge: NativeBridge;
+export default bridge;
