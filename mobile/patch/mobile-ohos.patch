+	if f == nil {
+		return ohReply(nil, errors.New("unknown binding operation"))
+	}
+	v, e := f(uint64(owner), args)
+	var value any
+	if e == nil {
+		value, e = ohEncode(uint64(owner), v)
+	}
+	return ohReply(value, e)
+}
+
+//export gomobileOHOSQueue
+func gomobileOHOSQueue(owner C.uint64_t, request C.uint64_t, operation *C.char, input *C.char) {
+	op, raw := C.GoString(operation), C.GoString(input)
+	go func() { reply := C.CString(ohCall(uint64(owner), op, raw)); C.oh_complete(owner, request, reply) }()
+}
