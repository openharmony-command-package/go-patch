+		env := ohosEnv(map[string]string{"GOOS": "openharmony", "GOARCH": arch, "GOARM": "7", "CGO_ENABLED": "1", "GOTOOLCHAIN": "local", "GOENV": "off", "OHOS_NDK_HOME": sdk, "CC": ccq, "CXX": cxxq, "AR": ar, "CGO_LDFLAGS": "-lace_napi.z", "GOWORK": "off"})
+		generated := filepath.Join(work, arch)
+		if err = os.MkdirAll(generated, 0755); err != nil {
