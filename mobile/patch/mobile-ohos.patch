diff --git a/bind/genopenharmony.go b/bind/genopenharmony.go
new file mode 100644
index 0000000..0c0cd8b
--- /dev/null
+++ b/bind/genopenharmony.go
@@ -0,0 +1,435 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+package bind
+
+import (
+	"bytes"
+	"embed"
+	"encoding/json"
+	"fmt"
+	"go/format"
+	"go/types"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+//go:embed openharmony/*.support
+var ohSupport embed.FS
+
+type ohGen struct {
+	pkgs            []*types.Package
+	names           map[*types.Package]string
+	bound           map[*types.Named]string
+	goSrc, ts, decl bytes.Buffer
+	callbacks       map[string]any
+}
+
+func (g *ohGen) typeName(t types.Type) string {
+	return types.TypeString(t, func(p *types.Package) string {
+		if name := g.names[p]; name != "" {
+			return name
+		}
+		name := fmt.Sprintf("pkg%d", len(g.names))
+		g.names[p] = name
+		return name
+	})
+}
+func (g *ohGen) spec(t types.Type) (string, error) {
+	if isErrorType(t) {
+		return "error", nil
+	}
+	switch t := types.Unalias(t).(type) {
+	case *types.Basic:
+		switch t.Kind() {
+		case types.Bool, types.UntypedBool:
+			return "bool", nil
+		case types.String, types.UntypedString:
+			return "string", nil
+		case types.Int64, types.Uint64:
+			return "bigint", nil
+		case types.Int, types.Int8, types.Int16, types.Int32, types.Uint, types.Uint8, types.Uint16, types.Uint32, types.UntypedInt, types.UntypedRune:
+			return "int", nil
+		case types.Float32, types.Float64, types.UntypedFloat:
+			return "number", nil
+		}
+	case *types.Slice:
+		if b, ok := t.Elem().Underlying().(*types.Basic); ok && b.Kind() == types.Uint8 {
+			return "bytes", nil
+		}
+	case *types.Pointer:
+		if n, ok := t.Elem().(*types.Named); ok {
+			if key := g.bound[n]; key != "" {
+				if _, ok := n.Underlying().(*types.Struct); ok {
+					return "#" + key, nil
+				}
+			}
+		}
+	case *types.Named:
+		if _, ok := t.Underlying().(*types.Basic); ok {
+			return g.spec(t.Underlying())
+		}
+		if _, ok := t.Underlying().(*types.Interface); ok {
+			if key := g.bound[t]; key != "" {
+				return "@" + key, nil
+			}
+		}
+	}
+	return "", fmt.Errorf("OHOS binding does not support %s", t)
+}
+func (g *ohGen) tsType(t types.Type) (string, error) {
+	s, e := g.spec(t)
+	if e != nil {
+		return "", e
+	}
+	switch s {
+	case "bool":
+		return "boolean", nil
+	case "string":
+		return "string", nil
+	case "error":
+		return "string | null", nil
+	case "int", "number":
+		return "number", nil
+	case "bigint":
+		return "bigint", nil
+	case "bytes":
+		return "Uint8Array | null", nil
+	}
+	if s[0] == '#' || s[0] == '@' {
+		return strings.ReplaceAll(s[1:], ".", "_") + " | null", nil
+	}
+	panic(s)
+}
+func (g *ohGen) signature(sig *types.Signature) (params, values, specs, result string, err error) {
+	if sig.Variadic() || sig.TypeParams() != nil && sig.TypeParams().Len() > 0 {
+		return "", "", "", "", fmt.Errorf("generic and variadic functions are unsupported")
+	}
+	var pp, vv, ss []string
+	for i := 0; i < sig.Params().Len(); i++ {
+		t := sig.Params().At(i).Type()
+		tt, e := g.tsType(t)
+		if e != nil {
+			err = e
+			return
+		}
+		s, e := g.spec(t)
+		if e != nil {
+			err = e
+			return
+		}
+		pp = append(pp, fmt.Sprintf("p%d: %s", i, tt))
+		vv = append(vv, fmt.Sprintf("p%d", i))
+		ss = append(ss, strconv.Quote(s))
+	}
+	out := sig.Results()
+	n := out.Len()
+	if n > 0 && isErrorType(out.At(n-1).Type()) {
+		n--
+	}
+	if n > 1 || out.Len() > 2 {
+		err = fmt.Errorf("functions must return at most one value and an optional error")
+		return
+	}
+	result = "void"
+	if n == 1 {
+		result, err = g.tsType(out.At(0).Type())
+	}
+	params, values, specs = strings.Join(pp, ", "), strings.Join(vv, ", "), strings.Join(ss, ", ")
+	return
+}
+func (g *ohGen) emitMethod(name, key string, sig *types.Signature, receiver bool) error {
+	params, values, specs, out, e := g.signature(sig)
+	if e != nil {
+		return fmt.Errorf("%s: %w", key, e)
+	}
+	args := "[" + values + "]"
+	if receiver {
+		args = "[this"
+		if values != "" {
+			args += ", " + values
+		}
+		args += "]"
+		specs = strconv.Quote("#"+strings.Join(strings.Split(key, ".")[:2], ".")) + func() string {
+			if specs != "" {
+				return ", " + specs
+			}
+			return ""
+		}()
+	}
+	fmt.Fprintf(&g.ts, "%s(%s): Promise<%s> { return _invoke(%q, %s, [%s]); },\n", name, params, out, key, args, specs)
+	fmt.Fprintf(&g.decl, "%s(%s): Promise<%s>;\n", name, params, out)
+	return nil
+}
+
+// GenOpenharmony writes an independent N-API binding. It does not include JNI
+// or Objective-C support and can therefore be cross-built from every Go host.
+func GenOpenharmony(dir string, pkgs []*types.Package) error {
+	g := &ohGen{pkgs: pkgs, names: map[*types.Package]string{}, bound: map[*types.Named]string{}, callbacks: map[string]any{}}
+	seen := map[string]bool{}
+	for i, p := range pkgs {
+		if p == nil || p.Name() == "main" {
+			return fmt.Errorf("cannot bind main or invalid package")
+		}
+		if seen[p.Name()] {
+			return fmt.Errorf("OHOS binding packages must have distinct names: %s", p.Name())
+		}
+		if strings.Contains(" class function let var const export import new delete typeof instanceof extends super this with yield await implements interface package private protected public static default enum null true false native initialize collect dispose _classes _interfaces _GoRef _alphabet _base64 _unbase64 _decode _interfaceRef _encode _invoke ", " "+p.Name()+" ") {
+			return fmt.Errorf("package name %s is a reserved TypeScript identifier; rename the Go package", p.Name())
+		}
+		seen[p.Name()] = true
+		g.names[p] = fmt.Sprintf("pkg%d", i)
+		for _, n := range p.Scope().Names() {
+			if !tokenExported(n) {
+				continue
+			}
+			if o, ok := p.Scope().Lookup(n).(*types.TypeName); ok {
+				if t, ok := o.Type().(*types.Named); ok {
+					switch t.Underlying().(type) {
+					case *types.Struct, *types.Interface:
+						if t.TypeParams() != nil && t.TypeParams().Len() > 0 {
+							return fmt.Errorf("generic type %s is unsupported", t)
+						}
+						g.bound[t] = p.Name() + "." + n
+					}
+				}
+			}
+		}
+	}
+	fmt.Fprintln(&g.goSrc, "// Code generated by gobind. DO NOT EDIT.\npackage main\nimport (\"reflect\"; \"encoding/json\"; \"fmt\"")
+	for _, p := range pkgs {
+		fmt.Fprintf(&g.goSrc, "%s %q\n", g.names[p], p.Path())
+	}
+	fmt.Fprintln(&g.goSrc, ")\nvar _ = json.RawMessage{}\nvar _ = fmt.Errorf")
+	runtimeTS, _ := ohSupport.ReadFile("openharmony/runtime.ts.support")
+	g.ts.Write(runtimeTS)
+	fmt.Fprintln(&g.decl, "export interface ApplicationContext { filesDir: string; cacheDir: string; tempDir: string; }\nexport interface InitializeOptions { timezone?: string; trustedCertDirs?: string[]; }\nexport function initialize(context: ApplicationContext, options?: InitializeOptions): Promise<void>;\nexport function collect(): void;\nexport function dispose(value: object | null): void;")
+	var registrations bytes.Buffer
+	for _, p := range pkgs {
+		for _, name := range p.Scope().Names() {
+			obj := p.Scope().Lookup(name)
+			if !obj.Exported() {
+				continue
+			}
+			key := p.Name() + "." + name
+			ref := g.names[p] + "." + name
+			named, ok := obj.Type().(*types.Named)
+			if _, isType := obj.(*types.TypeName); !isType || !ok {
+				continue
+			}
+			kind := named.Underlying()
+			class := strings.ReplaceAll(key, ".", "_")
+			switch t := kind.(type) {
+			case *types.Struct:
+				fmt.Fprintf(&registrations, "ohRegisterType(%q, reflect.TypeOf((*%s)(nil)), true)\n", key, ref)
+				fmt.Fprintf(&g.ts, "export class %s extends _GoRef { private constructor(token: object) { super(token); } static _wrap(id: number): %s { return new %s(native.own(id)); } static create(): Promise<%s> { return _invoke(%q, [], []); }\n", class, class, class, class, key+".new")
+				fmt.Fprintf(&g.decl, "export class %s { private constructor(); dispose(): void; static create(): Promise<%s>;\n", class, class)
+				memberNames := map[string]bool{}
+				set := types.NewMethodSet(types.NewPointer(named))
+				for i := 0; i < set.Len(); i++ {
+					m := set.At(i).Obj().(*types.Func)
+					if !m.Exported() {
+						continue
+					}
+					memberNames[m.Name()] = true
+					if e := g.emitMethod(m.Name(), key+"."+m.Name(), m.Type().(*types.Signature), true); e != nil {
+						return e
+					}
+					b := g.ts.Bytes()
+					if b[g.ts.Len()-2] == ',' {
+						g.ts.Truncate(g.ts.Len() - 2)
+						g.ts.WriteString("\n")
+					}
+				}
+				for i := 0; i < t.NumFields(); i++ {
+					f := t.Field(i)
+					if !f.Exported() || f.Anonymous() {
+						continue
+					}
+					tt, e := g.tsType(f.Type())
+					if e != nil {
+						return fmt.Errorf("%s.%s: %w", key, f.Name(), e)
+					}
+					spec, _ := g.spec(f.Type())
+					if memberNames["Get"+f.Name()] || memberNames["Set"+f.Name()] {
+						return fmt.Errorf("field accessor conflicts with method: %s.%s", key, f.Name())
+					}
+					fmt.Fprintf(&g.ts, "Get%s(): Promise<%s> { return _invoke(%q, [this], [%q]); }\nSet%s(value: %s): Promise<void> { return _invoke(%q, [this,value], [%q,%q]); }\n", f.Name(), tt, key+"."+f.Name()+".get", "#"+key, f.Name(), tt, key+"."+f.Name()+".set", "#"+key, spec)
+					fmt.Fprintf(&g.decl, "Get%s(): Promise<%s>; Set%s(value: %s): Promise<void>;\n", f.Name(), tt, f.Name(), tt)
+				}
+				fmt.Fprintf(&g.ts, "}\n_classes[%q]=%s._wrap;\n", key, class)
+				fmt.Fprintln(&g.decl, "}")
+			case *types.Interface:
+				t.Complete()
+				if !t.IsMethodSet() {
+					return fmt.Errorf("constraint interface %s is unsupported", named)
+				}
+				fmt.Fprintf(&g.ts, "export interface %s {\n", class)
+				fmt.Fprintf(&g.decl, "export interface %s {\n", class)
+				methods := map[string]any{}
+				for i := 0; i < t.NumMethods(); i++ {
+					m := t.Method(i)
+					if !m.Exported() {
+						return fmt.Errorf("interface contains unexported method: %s", named)
+					}
+					sig := m.Type().(*types.Signature)
+					params, _, _, out, e := g.signature(sig)
+					if e != nil {
+						return e
+					}
+					fmt.Fprintf(&g.ts, "%s(%s): %s | Promise<%s>;\n", m.Name(), params, out, out)
+					fmt.Fprintf(&g.decl, "%s(%s): %s | Promise<%s>;\n", m.Name(), params, out, out)
+					specs := []string{}
+					for j := 0; j < sig.Params().Len(); j++ {
+						s, _ := g.spec(sig.Params().At(j).Type())
+						specs = append(specs, s)
+					}
+					result := "void"
+					n := sig.Results().Len()
+					if n > 0 && isErrorType(sig.Results().At(n-1).Type()) {
+						n--
+					}
+					if n == 1 {
+						result, _ = g.spec(sig.Results().At(0).Type())
+
+					}
+					methods[m.Name()] = map[string]any{"args": specs, "result": result}
+				}
+				fmt.Fprintln(&g.ts, "}")
+				fmt.Fprintln(&g.decl, "}")
+				fmt.Fprintf(&g.ts, "_classes[%q]=(id: number) => _interfaceRef(id, %q);\n", key, key)
+				g.callbacks[key] = methods
+				fmt.Fprintf(&registrations, "ohRegisterType(%q, reflect.TypeOf((*%s)(nil)).Elem(), false)\nohInterfaces[reflect.TypeOf((*%s)(nil)).Elem()] = func(owner,id uint64)(reflect.Value,error){p,e:=ohNewForeign(owner,id);if e!=nil{return reflect.Value{},e};return reflect.ValueOf(&ohProxy_%s{p}),nil}\n", key, ref, ref, class)
+				fmt.Fprintf(&g.goSrc, "type ohProxy_%s struct {*ohForeign}\n", class)
+				for i := 0; i < t.NumMethods(); i++ {
+					m := t.Method(i)
+					sig := m.Type().(*types.Signature)
+					var pp, rv, values []string
+					for j := 0; j < sig.Params().Len(); j++ {
+						pp = append(pp, fmt.Sprintf("p%d %s", j, g.typeName(sig.Params().At(j).Type())))
+						values = append(values, fmt.Sprintf("reflect.ValueOf(&p%d).Elem()", j))
+					}
+					for j := 0; j < sig.Results().Len(); j++ {
+						rv = append(rv, fmt.Sprintf("r%d %s", j, g.typeName(sig.Results().At(j).Type())))
+					}
+					fmt.Fprintf(&g.goSrc, "func(p *ohProxy_%s) %s(%s)(%s){raw,cleanup,e:=p.call(%q", class, m.Name(), strings.Join(pp, ","), strings.Join(rv, ","), m.Name())
+					if len(values) > 0 {
+						fmt.Fprintf(&g.goSrc, ",%s", strings.Join(values, ","))
+					}
+					fmt.Fprintln(&g.goSrc, "); defer cleanup()")
+					n := sig.Results().Len()
+					hasErr := n > 0 && isErrorType(sig.Results().At(n-1).Type())
+					if hasErr {
+						n--
+					}
+					if n == 1 {
+						ty := g.typeName(sig.Results().At(0).Type())
+						fmt.Fprintf(&g.goSrc, "if e==nil{var v reflect.Value;v,e=ohDecode(p.owner,raw,reflect.TypeOf((*%s)(nil)).Elem());if e==nil{r0=v.Interface().(%s)}}\n", ty, ty)
+					} else {
+						fmt.Fprintln(&g.goSrc, "_ = raw")
+					}
+					if hasErr {
+						fmt.Fprintf(&g.goSrc, "r%d=e\nreturn\n}\n", sig.Results().Len()-1)
+					} else {
+						fmt.Fprintln(&g.goSrc, "if e!=nil{panic(e)};return\n}")
+					}
+				}
+			}
+		}
+		fmt.Fprintf(&g.ts, "export const %s = {\n", p.Name())
+		fmt.Fprintf(&g.decl, "export const %s: {\n", p.Name())
+		publicNames := map[string]bool{}
+		for _, name := range p.Scope().Names() {
+			obj := p.Scope().Lookup(name)
+			if !obj.Exported() {
+				continue
+			}
+			if _, ok := obj.(*types.Func); ok {
+				publicNames[name] = true
+			}
+		}
+		for _, name := range p.Scope().Names() {
+			obj := p.Scope().Lookup(name)
+			if !obj.Exported() {
+				continue
+			}
+			key := p.Name() + "." + name
+			ref := g.names[p] + "." + name
+			switch o := obj.(type) {
+			case *types.Func:
+				if e := g.emitMethod(name, key, o.Type().(*types.Signature), false); e != nil {
+					return e
+				}
+				fmt.Fprintf(&registrations, "ohRegisterFunc(%q,reflect.ValueOf(%s))\n", key, ref)
+			case *types.Var, *types.Const:
+				if publicNames["Get"+name] || publicNames["Set"+name] {
+					return fmt.Errorf("package accessor conflict: %s", key)
+				}
+				tt, e := g.tsType(types.Default(obj.Type()))
+				if e != nil {
+					return fmt.Errorf("%s: %w", key, e)
+				}
+				spec, _ := g.spec(types.Default(obj.Type()))
+				fmt.Fprintf(&g.ts, "Get%s(): Promise<%s> { return _invoke(%q,[],[]); },\n", name, tt, key+".get")
+				fmt.Fprintf(&g.decl, "Get%s(): Promise<%s>;\n", name, tt)
+				if _, ok := o.(*types.Var); ok {
+					fmt.Fprintf(&g.ts, "Set%s(value: %s): Promise<void> {return _invoke(%q,[value],[%q]);},\n", name, tt, key+".set", spec)
+					fmt.Fprintf(&g.decl, "Set%s(value: %s): Promise<void>;\n", name, tt)
+					fmt.Fprintf(&registrations, "ohRegisterVar(%q,reflect.ValueOf(&%s).Elem())\n", key, ref)
+				} else {
+					fmt.Fprintf(&registrations, "ohRegisterFunc(%q,reflect.ValueOf(func() %s{return %s}))\n", key+".get", g.typeName(types.Default(obj.Type())), ref)
+				}
+			}
+		}
+		fmt.Fprintln(&g.ts, "};")
+		fmt.Fprintln(&g.decl, "};")
+	}
+	fmt.Fprintf(&g.goSrc, "func init(){\n%s}\n", registrations.Bytes())
+	source := g.goSrc.String()
+	extra := []string{}
+	for p, name := range g.names {
+		found := false
+		for _, bound := range pkgs {
+			if p == bound {
+				found = true
+			}
+		}
+		if !found {
+			extra = append(extra, fmt.Sprintf("%s %q", name, p.Path()))
+		}
+	}
+	sort.Strings(extra)
+	if len(extra) > 0 {
+		source = strings.Replace(source, "\n)\n", "\n"+strings.Join(extra, "\n")+"\n)\n", 1)
+	}
+	formatted, e := format.Source([]byte(source))
+	if e != nil {
+		return fmt.Errorf("generated Go: %w\n%s", e, g.goSrc.Bytes())
+	}
+	callbackJSON, _ := json.Marshal(g.callbacks)
+	fmt.Fprintf(&g.ts, "Object.assign(_interfaces, %s);\n", callbackJSON)
+	if e = os.MkdirAll(filepath.Join(dir, "src", "gobind"), 0755); e != nil {
+		return e
+	}
+	for _, name := range []string{"runtime.go", "paths_openharmony.go", "paths_host.go", "bridge.c", "bridge.h"} {
+		data, e := ohSupport.ReadFile("openharmony/" + name + ".support")
+		if e != nil {
+			return e
+		}
+		if e = os.WriteFile(filepath.Join(dir, "src", "gobind", name), data, 0644); e != nil {
+			return e
+		}
+	}
+	nativeTypes, _ := ohSupport.ReadFile("openharmony/native.d.ts.support")
+	for name, data := range map[string][]byte{"native.d.ts": nativeTypes, "src/gobind/bindings.go": formatted, "Index.ts": g.ts.Bytes(), "Index.d.ts": g.decl.Bytes()} {
+		if e = os.WriteFile(filepath.Join(dir, filepath.FromSlash(name)), data, 0644); e != nil {
+			return e
+		}
+	}
+	return nil
+}
+func tokenExported(name string) bool {
+	return len(name) > 0 && types.NewVar(0, nil, name, nil).Exported()
+}
diff --git a/bind/genopenharmony_test.go b/bind/genopenharmony_test.go
new file mode 100644
index 0000000..b55f685
--- /dev/null
+++ b/bind/genopenharmony_test.go
@@ -0,0 +1,72 @@
+package bind
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"go/types"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestOpenharmonyGenerator(t *testing.T) {
+	for _, test := range []struct{ name, source, want string }{
+		{"typed", "package sample; type Item struct { Count int64 }; func NewItem() *Item {return nil}; type Listener interface { OnValue(v string)(string,error) };func Call(l Listener){}", ""},
+		{"map", "package sample;func Bad(m map[string]string){}", "does not support"},
+		{"channel", "package sample;func Bad(c chan int){}", "does not support"},
+		{"variadic", "package sample;func Bad(v ...string){}", "variadic"},
+		{"generic", "package sample;type Item[T any] struct{Value T}", "generic"},
+		{"unexported-interface", "package sample;type Listener interface{ hidden() };func Call(l Listener){}", "unexported method"},
+		{"reserved-name", "package native;func Call(){}", "reserved"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			fs := token.NewFileSet()
+			f, e := parser.ParseFile(fs, "sample.go", test.source, 0)
+			if e != nil {
+				t.Fatal(e)
+			}
+			p, e := new(types.Config).Check("example.org/sample", fs, []*ast.File{f}, nil)
+			if e != nil {
+				t.Fatal(e)
+			}
+			dir := t.TempDir()
+			e = GenOpenharmony(dir, []*types.Package{p})
+			if test.want != "" {
+				if e == nil || !strings.Contains(e.Error(), test.want) {
+					t.Fatalf("got %v, want %q", e, test.want)
+				}
+				return
+			}
+			if e != nil {
+				t.Fatal(e)
+			}
+			for _, name := range []string{"bindings.go", "runtime.go", "paths_host.go", "paths_openharmony.go"} {
+				if _, e = parser.ParseFile(token.NewFileSet(), filepath.Join(dir, "src/gobind", name), nil, parser.AllErrors); e != nil {
+					t.Fatal(e)
+				}
+			}
+			declaration, e := os.ReadFile(filepath.Join(dir, "Index.d.ts"))
+			if e != nil {
+				t.Fatal(e)
+			}
+			for _, text := range []string{"Count(): Promise<bigint>", "NewItem(): Promise<sample_Item | null>", "OnValue(p0: string): string | Promise<string>"} {
+				if !strings.Contains(string(declaration), text) {
+					t.Errorf("missing declaration %q", text)
+				}
+			}
+			second := t.TempDir()
+			if e = GenOpenharmony(second, []*types.Package{p}); e != nil {
+				t.Fatal(e)
+			}
+			for _, name := range []string{"Index.ts", "Index.d.ts", "src/gobind/bindings.go"} {
+				a, _ := os.ReadFile(filepath.Join(dir, name))
+				b, _ := os.ReadFile(filepath.Join(second, name))
