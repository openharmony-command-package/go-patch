+func packOHOSHar(work, output string) (err error) {
+	f, err := os.CreateTemp(filepath.Dir(output), ".gomobile-har-*")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer func() { f.Close(); os.Remove(name) }()
+	gz := gzip.NewWriter(f)
+	gz.Header.ModTime = time.Unix(0, 0)
+	tw := tar.NewWriter(gz)
+	err = filepath.Walk(filepath.Join(work, "package"), func(path string, info os.FileInfo, e error) error {
+		if e != nil {
+			return e
+		}
+		if info.IsDir() {
+			return nil
+		}
+		if !info.Mode().IsRegular() {
+			return fmt.Errorf("unexpected archive member: %s", path)
+		}
+		rel, e := filepath.Rel(work, path)
+		if e != nil {
+			return e
+		}
+		h := &tar.Header{Name: filepath.ToSlash(rel), Mode: 0644, Size: info.Size(), ModTime: time.Unix(0, 0)}
+		if e = tw.WriteHeader(h); e != nil {
+			return e
+		}
+		in, e := os.Open(path)
+		if e != nil {
+			return e
+		}
+		_, e = io.Copy(tw, in)
+		ce := in.Close()
+		if e != nil {
+			return e
+		}
+		return ce
+	})
+	if err != nil {
+		return err
+	}
+	if err = tw.Close(); err != nil {
+		return err
+	}
+	if err = gz.Close(); err != nil {
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+	return os.Rename(name, output)
+}
