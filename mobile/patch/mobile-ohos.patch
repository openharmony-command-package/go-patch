+		}
+		if len(buildTags) > 0 {
+			buildArgs = append(buildArgs, "-tags", strings.Join(buildTags, ","))
+		}
+		buildArgs = append(buildArgs, "./src/gobind")
+		if err = ohosRun(generated, env, goexe, buildArgs...); err != nil {
+			return err
+		}
