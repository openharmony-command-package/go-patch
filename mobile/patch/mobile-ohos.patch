+	"golang.org/x/mod/module"
+)
+
+func isOHOSTarget(target string) bool {
+	first := strings.Split(strings.Split(target, ",")[0], "/")[0]
+	return first == "openharmony" || first == "ohos"
+}
+func ohosTargets(target string) ([]string, error) {
+	seen := map[string]bool{}
+	var out []string
+	for _, entry := range strings.Split(target, ",") {
+		parts := strings.Split(entry, "/")
+		if len(parts) > 2 || !isOHOSTarget(entry) {
+			return nil, fmt.Errorf("OHOS targets cannot be mixed with other platforms")
+		}
+		arches := []string{"arm64", "arm", "amd64"}
+		if len(parts) == 2 {
+			switch parts[1] {
+			case "arm64", "aarch64", "arm64-v8a":
+				arches = []string{"arm64"}
+			case "arm", "armv7a", "armeabi-v7a":
+				arches = []string{"arm"}
+			case "amd64", "x86_64":
+				arches = []string{"amd64"}
+			default:
+				return nil, fmt.Errorf("unsupported OHOS architecture %q", parts[1])
+			}
+		}
+		for _, arch := range arches {
+			if seen[arch] {
+				return nil, fmt.Errorf("duplicate OHOS architecture %s", arch)
+			}
+			seen[arch] = true
+			out = append(out, arch)
+		}
+	}
+	return out, nil
+}
+func ohosRun(at string, env []string, name string, args ...string) error {
+	if buildV || buildX || buildN {
+		fmt.Fprintln(os.Stderr, name, strings.Join(args, " "))
+	}
+	if buildN {
+		return nil
+	}
+	c := exec.Command(name, args...)
+	c.Dir = at
+	c.Env = env
+	c.Stdout = os.Stdout
+	c.Stderr = os.Stderr
+	return c.Run()
+}
+func ohosEnv(values map[string]string) []string {
+	out := []string{}
+	for _, line := range os.Environ() {
+		key, _, _ := strings.Cut(line, "=")
+		if _, ok := values[key]; !ok {
+			out = append(out, line)
+		}
+	}
+	for k, v := range values {
+		out = append(out, k+"="+v)
+	}
+	return out
+}
+func ohosQuote(s string) (string, error) {
+	if !strings.Contains(s, "'") {
+		return "'" + s + "'", nil
+	}
+	if !strings.Contains(s, "\"") {
+		return "\"" + s + "\"", nil
+	}
+	return "", fmt.Errorf("compiler path contains both kinds of quote")
+}
+func runOHOSBind(cmd *command) error {
