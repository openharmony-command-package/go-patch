diff --git a/cmd/gomobile/ohos_version.go b/cmd/gomobile/ohos_version.go
new file mode 100644
index 0000000..40fdb90
--- /dev/null
+++ b/cmd/gomobile/ohos_version.go
@@ -0,0 +1,53 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+)
+
+// Set by the reproducible package builder for both gomobile and gobind.
+var ohosRevision = "development"
+var ohosInitTarget string
+
+func runOHOSInit() error {
+	if _, err := ohosTargets(ohosInitTarget); err != nil {
+		return err
+	}
+	sdk := os.Getenv("OHOS_NDK_HOME")
+	if _, err := os.Stat(filepath.Join(sdk, "sysroot", "usr", "include", "napi", "native_api.h")); sdk == "" || err != nil {
+		return fmt.Errorf("set OHOS_NDK_HOME to the OpenHarmony native SDK")
+	}
+	out, err := exec.Command("go", "tool", "dist", "list").Output()
+	if err != nil {
+		return err
+	}
+	if !strings.Contains(string(out), "openharmony/arm64\n") {
+		return fmt.Errorf("OHOS requires the patched Go toolchain")
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		return err
+	}
+	bind := filepath.Join(filepath.Dir(exe), "gobind")
+	if runtime.GOOS == "windows" {
+		bind += ".exe"
+	}
+	return checkOHOSGobind(bind)
+}
+func checkOHOSGobind(path string) error {
+	out, err := exec.Command(path, "-version").Output()
+	if err != nil {
+		return fmt.Errorf("OHOS requires the matching patched gobind next to gomobile: %w", err)
+	}
+	if strings.TrimSpace(string(out)) != "gobind ohos "+ohosRevision {
+		return fmt.Errorf("gomobile/gobind OHOS revisions differ: %s", strings.TrimSpace(string(out)))
+	}
+	return nil
+}
+func init() {
+	cmdInit.flag.StringVar(&ohosInitTarget, "target", "", "target platform; openharmony checks the bundled tools without replacing gobind")
+}
