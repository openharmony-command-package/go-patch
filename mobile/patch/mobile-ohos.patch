+	}
+	mf, err := modfile.Parse(gomod, original, nil)
+	if err != nil {
+		return err
+	}
+	caller := mf.Module.Mod.Path
+	if err = mf.AddModuleStmt("gomobile.local/ohosbindings"); err != nil {
+		return err
+	}
+	_, major, _ := module.SplitPathVersion(caller)
+	version := "v0.0.0"
+	if major != "" {
+		version = strings.TrimPrefix(strings.TrimPrefix(major, "/"), ".") + ".0.0"
+	}
+	if err = mf.AddRequire(caller, version); err != nil {
+		return err
+	}
+	if err = mf.AddReplace(caller, "", filepath.Dir(gomod), ""); err != nil {
+		return err
+	}
+	for _, r := range mf.Replace {
+		if r.New.Version == "" && !filepath.IsAbs(r.New.Path) {
+			abs := filepath.Join(filepath.Dir(gomod), r.New.Path)
+			if err = mf.AddReplace(r.Old.Path, r.Old.Version, abs, ""); err != nil {
+				return err
+			}
+		}
+	}
+	moddata, err := mf.Format()
+	if err != nil {
+		return err
+	}
+	work, err := os.MkdirTemp("", "gomobile-ohos-")
+	if err != nil {
+		return err
+	}
+	defer func() {
+		if buildWork {
+			fmt.Fprintln(os.Stderr, "WORK="+work)
+		} else {
+			os.RemoveAll(work)
+		}
+	}()
+	output := buildO
+	if output == "" {
+		output = "gomobile.har"
+	}
+	if filepath.Ext(output) != ".har" {
+		return fmt.Errorf("OHOS bind output must end in .har")
+	}
+	output, err = filepath.Abs(output)
+	if err != nil {
+		return err
+	}
+	if buildN {
+		fmt.Fprintln(os.Stderr, "OHOS HAR:", output, "architectures:", strings.Join(targets, ","))
+		return nil
+	}
+	packageDir := filepath.Join(work, "package")
+	if err = os.MkdirAll(packageDir, 0755); err != nil {
+		return err
+	}
+	var declarations, api []byte
+	nativeHashes := map[string]string{}
+	evidence := map[string]any{"format": "gomobile-ohos-har-v1", "go_version": "", "architectures": targets, "signing": "HAP application signing at final application packaging", "module": caller, "mobile_patch_revision": ohosRevision, "minimum_api": 12}
+	versionCmd := exec.Command(goexe, "version")
+	versionBytes, err := versionCmd.Output()
+	if err != nil {
+		return err
+	}
+	evidence["go_version"] = strings.TrimSpace(string(versionBytes))
+	goBinary, err := os.ReadFile(goexe)
+	if err != nil {
+		return err
+	}
+	evidence["go_executable_sha256"] = fmt.Sprintf("%x", sha256.Sum256(goBinary))
+	evidence["go_patch_sha256"] = "unrecorded"
+	if buildInfo, readErr := os.ReadFile(filepath.Join(goroot, "BUILD-INFO.json")); readErr == nil {
+		var info struct {
+			PatchSHA256 string `json:"patch_sha256"`
+		}
+		if err := json.Unmarshal(buildInfo, &info); err != nil {
+			return fmt.Errorf("invalid Go BUILD-INFO: %w", err)
+		}
+		if len(info.PatchSHA256) != 64 {
