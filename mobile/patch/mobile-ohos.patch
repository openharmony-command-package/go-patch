+async function _invoke(op: string,args: any[],specs: string[]): Promise<any> {const keep: number[]=[];try{const encoded=args.map((v,i)=>_encode(v,specs[i],keep));const reply=JSON.parse(await native.call(op,JSON.stringify(encoded)));if('error' in reply)throw new Error(reply.error);return _decode(reply.value);}finally{for(const id of keep)native.dropCallback(id);}}
