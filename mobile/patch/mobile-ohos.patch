+//export gomobileOHOSRelease
+func gomobileOHOSRelease(owner C.uint64_t, id C.uint64_t) {
+	ohMu.Lock()
+	if v, ok := ohObjects[uint64(id)]; ok && v.owner == uint64(owner) {
+		delete(ohObjects, uint64(id))
+	}
+	ohMu.Unlock()
+}
+
+//export gomobileOHOSClose
+func gomobileOHOSClose(owner C.uint64_t) {
+	ohMu.Lock()
+	delete(ohOwners, uint64(owner))
+	for id, v := range ohObjects {
+		if v.owner == uint64(owner) {
+			delete(ohObjects, id)
+		}
+	}
+	ohMu.Unlock()
+}
+
+//export gomobileOHOSCollect
+func gomobileOHOSCollect() { runtime.GC() }
+
+type ohForeign struct{ owner, id uint64 }
+
+func ohNewForeign(owner, id uint64) (*ohForeign, error) {
+	if C.oh_callback_acquire(C.uint64_t(owner), C.uint64_t(id)) == 0 {
+		return nil, errors.New("callback environment closed")
+	}
+	p := &ohForeign{owner, id}
+	runtime.SetFinalizer(p, func(p *ohForeign) { C.oh_callback_release(C.uint64_t(p.owner), C.uint64_t(p.id)) })
+	return p, nil
+}
+func (p *ohForeign) call(name string, args ...reflect.Value) (json.RawMessage, func(), error) {
+	values := make([]any, len(args))
+	for i, v := range args {
+		x, e := ohEncode(p.owner, v)
+		if e != nil {
+			return nil, func() {}, e
+		}
+		values[i] = x
+	}
+	data, e := json.Marshal(values)
+	if e != nil {
+		return nil, func() {}, e
+	}
+	cn, ca := C.CString(name), C.CString(string(data))
+	defer C.free(unsafe.Pointer(cn))
+	defer C.free(unsafe.Pointer(ca))
+	r := C.oh_callback_request(C.uint64_t(p.owner), C.uint64_t(p.id), cn, ca)
+	runtime.KeepAlive(p)
+	if r == nil {
+		return nil, func() {}, errors.New("callback environment closed")
+	}
+	defer C.free(unsafe.Pointer(r))
+	var reply struct {
+		Value     json.RawMessage `json:"value"`
+		Error     string          `json:"error"`
+		Callbacks []uint64        `json:"callbacks"`
+	}
+	if e = json.Unmarshal([]byte(C.GoString(r)), &reply); e != nil {
+		return nil, func() {}, e
+	}
+	cleanup := func() {
+		for _, id := range reply.Callbacks {
+			C.oh_callback_release(C.uint64_t(p.owner), C.uint64_t(id))
+		}
+	}
+	if reply.Error != "" {
+		return nil, cleanup, errors.New(reply.Error)
+	}
+	return reply.Value, cleanup, nil
+}
