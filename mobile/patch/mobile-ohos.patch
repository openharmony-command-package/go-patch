+      call, own, unwrap, dispose, register_callback, drop_callback, collect};
+  for (unsigned i = 0; i < sizeof(funcs) / sizeof(funcs[0]); i++) {
+    napi_value fn;
+    OH_CHECK(napi_create_function(env, names[i], NAPI_AUTO_LENGTH, funcs[i], s,
+                                  &fn));
+    OH_CHECK(napi_set_named_property(env, exports, names[i], fn));
+  }
