+package main
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestOHOSTargets(t *testing.T) {
+	for _, x := range []struct {
+		target string
+		arches []string
+	}{
+		{"openharmony", []string{"arm64", "arm", "amd64"}},
+		{"ohos/arm64,openharmony/x86_64", []string{"arm64", "amd64"}},
+		{"ohos/armeabi-v7a", []string{"arm"}},
+		{"ohos/386", nil}, {"ohos,ohos/arm64", nil}, {"ohos/arm,android/arm", nil}, {"ohos/arm/extra", nil},
+	} {
+		got, e := ohosTargets(x.target)
+		if x.arches == nil {
+			if e == nil {
+				t.Errorf("accepted %s", x.target)
+			}
+			continue
+		}
+		if e != nil || !reflect.DeepEqual(got, x.arches) {
+			t.Errorf("%s: %v %v", x.target, got, e)
+		}
+	}
+}
