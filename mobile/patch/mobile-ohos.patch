+			suffix = ".exe"
+		}
+		cc := filepath.Join(goroot, "ohos-scripts", "cc-"+arch+suffix)
+		cxx := filepath.Join(goroot, "ohos-scripts", "cxx-"+arch+suffix)
+		if supplied := os.Getenv("CC"); supplied != "" {
+			cc = supplied
+		} else if _, err = os.Stat(cc); err != nil {
+			return fmt.Errorf("compiler wrapper missing: %s", cc)
+		}
+		ccq, err := ohosQuote(cc)
+		if err != nil {
+			return err
+		}
+		cxxq, err := ohosQuote(cxx)
+		if err != nil {
+			return err
+		}
+		if supplied := os.Getenv("CC"); supplied != "" {
+			ccq = supplied
+		}
+		if supplied := os.Getenv("CXX"); supplied != "" {
+			cxxq = supplied
+		}
+		ar := filepath.Join(sdk, "llvm", "bin", "llvm-ar"+suffix)
+		if supplied := os.Getenv("AR"); supplied != "" {
