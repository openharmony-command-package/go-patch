+//go:build openharmony
+
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"os/openharmony"
+)
+
+func ohConfigure(args []json.RawMessage) error {
+	if len(args) != 1 {
+		return errors.New("expected Context configuration")
+	}
+	var c struct {
+		FilesDir, CacheDir, TempDir, Timezone string
+		TrustedCertDirs                       []string
+	}
+	if e := json.Unmarshal(args[0], &c); e != nil {
+		return e
+	}
+	return openharmony.Configure(openharmony.Config{FilesDir: c.FilesDir, CacheDir: c.CacheDir, TempDir: c.TempDir, Timezone: c.Timezone, TrustedCertDirs: c.TrustedCertDirs})
+}
