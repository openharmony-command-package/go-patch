 	syscall.Kill(syscall.Getpid(), syscall.SIGSEGV)
 
 	// Wait for the OS to deliver the signal.
-	C.pause()
+	for {
+		// pause may return for an unrelated signal, including Go's SIGURG
+		// preemption signal. Keep the helper alive until SIGSEGV is handled.
+		C.pause()
+	}
 }
