+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+#include "textflag.h"
+#include "go_asm.h"
+TEXT ·raw3(SB),NOSPLIT,$0-48
+ MOVQ trap+0(FP),AX
+ MOVQ a1+8(FP),DI
+ MOVQ a2+16(FP),SI
+ MOVQ a3+24(FP),DX
+ SYSCALL
+ CMPQ AX,$0xfffffffffffff001
+ JLS ok
+ NEGQ AX
+ MOVQ AX,errno+40(FP)
+ MOVQ $-1,result+32(FP)
+ RET
+ok:
+ MOVQ AX,result+32(FP)
+ MOVQ $0,errno+40(FP)
+ RET
+
+TEXT ·raw0(SB),NOSPLIT,$0-16
+ MOVQ trap+0(FP),AX
+ SYSCALL
+ MOVQ AX,ret+8(FP)
+ RET
+
+// Internal logger descriptors must never replace closed stdin/stdout/stderr.
+TEXT ·socketFD(SB),NOSPLIT,$0-4
+ MOVQ $const_sysSocket,AX
+ MOVQ $1,DI
+ MOVQ $0x80802,SI
+ XORQ DX,DX
+ SYSCALL
+ CMPQ AX,$3
+ JAE socketdone
+ MOVQ AX,R8
+ MOVQ AX,DI
+ MOVQ $const_sysFcntl,AX
+ MOVQ $1030,SI
+ MOVQ $3,DX
+ SYSCALL
+ MOVQ AX,R9
+ MOVQ $const_sysClose,AX
+ MOVQ R8,DI
+ SYSCALL
+ MOVQ R9,AX
+socketdone:
+ MOVL AX,ret+0(FP)
+ RET
