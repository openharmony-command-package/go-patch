+void x_cgo_ohos_timezone(void *opaque) {
+    struct args { char *buf; uintptr_t size; int32_t result; } *a = opaque;
+    typedef int (*get_parameter)(const char *, const char *, char *, unsigned int);
+    void *h = dlopen("libbegetutil.z.so", RTLD_LAZY | RTLD_LOCAL);
+    get_parameter get;
+    a->result = 0;
+    if (!h) return;
+    get = (get_parameter)dlsym(h, "GetParameter");
+    if (get) a->result = get("persist.time.timezone", "", a->buf, (unsigned int)a->size);
+    dlclose(h);
+}
