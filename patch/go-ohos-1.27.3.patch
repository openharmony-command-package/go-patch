diff --git a/src/log/hilog/hilog.go b/src/log/hilog/hilog.go
new file mode 100644
index 00000000..d8721243
--- /dev/null
+++ b/src/log/hilog/hilog.go
@@ -0,0 +1,86 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Package hilog sends preformatted application logs to OpenHarmony HiLog.
+// Standard stdout/stderr and runtime diagnostics are mirrored automatically on
+// OHOS; this package provides explicit domain, tag and level selection.
+package hilog
+
+import (
+	"context"
+	"errors"
+	transport "internal/runtime/hilog"
+	"log/slog"
+)
+
+type Level uint8
+
+const (
+	Debug Level = 3
+	Info  Level = 4
+	Warn  Level = 5
+	Error Level = 6
+	Fatal Level = 7
+)
+
+// Writer sends each Write as one or more bounded LOG_APP records. Text has
+// already been formatted and is public, including any slog attributes.
+type Writer struct {
+	Domain uint32
+	Tag    string
+	Level  Level
+}
+
+func (w Writer) Write(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	if !transport.Write(uint8(w.Level), w.Domain, w.Tag, p) {
+		return 0, errors.New("hilog: invalid metadata, busy transport, or hilogd unavailable")
+	}
+	return len(p), nil
+}
+
+// SetStdioMirroring enables or disables the additional HiLog copy of Go stdio
+// and runtime diagnostics. The default is enabled; GO_OHOS_HILOG=0 disables it
+// at startup. Explicit Writer and Handler output is unaffected.
+func SetStdioMirroring(enabled bool) { transport.SetEnabled(enabled) }
+
+type handler struct{ levels [4]slog.Handler }
+
+// NewHandler returns a text slog handler preserving attributes, groups and
+// HandlerOptions while mapping each record's severity to the HiLog level.
+func NewHandler(domain uint32, tag string, opts *slog.HandlerOptions) slog.Handler {
+	h := &handler{}
+	for i, level := range []Level{Debug, Info, Warn, Error} {
+		h.levels[i] = slog.NewTextHandler(Writer{domain, tag, level}, opts)
+	}
+	return h
+}
+func (h *handler) Enabled(ctx context.Context, l slog.Level) bool { return h.levels[0].Enabled(ctx, l) }
+func (h *handler) Handle(ctx context.Context, r slog.Record) error {
+	i := 0
+	if r.Level >= slog.LevelError {
+		i = 3
+	} else if r.Level >= slog.LevelWarn {
+		i = 2
+	} else if r.Level >= slog.LevelInfo {
+		i = 1
+	}
+	return h.levels[i].Handle(ctx, r)
+}
+func (h *handler) WithAttrs(attrs []slog.Attr) slog.Handler {
+	n := &handler{}
+	for i := range n.levels {
+		n.levels[i] = h.levels[i].WithAttrs(attrs)
+	}
+	return n
+}
+func (h *handler) WithGroup(name string) slog.Handler {
+	n := &handler{}
+	for i := range n.levels {
+		n.levels[i] = h.levels[i].WithGroup(name)
+	}
+	return n
+}
