diff --git a/src/debug/dwarf/base_offsets_test.go b/src/debug/dwarf/base_offsets_test.go
new file mode 100644
index 00000000..86469bdd
--- /dev/null
+++ b/src/debug/dwarf/base_offsets_test.go
@@ -0,0 +1,59 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package dwarf_test
+
+import (
+	"debug/dwarf"
+	"encoding/binary"
+	"testing"
+)
+
+func TestDwarf5IndexedAttributeBases(t *testing.T) {
+	// The indexed attribute precedes its base in the compilation unit. The
+	// first pass must collect that base without reading the wrong table.
+	for _, name := range []string{"strx", "rnglistx"} {
+		t.Run(name, func(t *testing.T) {
+			attr, form, baseAttr, index, base := byte(0x03), byte(0x25), byte(0x72), byte(0), uint32(8)
+			section := ".debug_str_offsets"
+			table := []byte{8, 0, 0, 0, 5, 0, 0, 0, 0, 0, 0, 0}
+			var want any = "name"
+			if name == "rnglistx" {
+				attr, form, baseAttr, index, base = 0x55, 0x23, 0x74, 3, 52
+				section = ".debug_rnglists"
+				table = make([]byte, 80)
+				for _, start := range []int{0, 40} {
+					binary.LittleEndian.PutUint32(table[start:], 36)
+					table[start+4], table[start+6] = 5, 4
+				}
+				// A range in an earlier contribution starts with a long LEB.
+				// Reading it as an offset overflows int on 32-bit readers.
+				copy(table[12:], []byte{3, 0x80, 0x80, 0x80, 0, 0, 0})
+				binary.LittleEndian.PutUint32(table[48:], 4)
+				for i := 52; i < 68; i += 4 {
+					binary.LittleEndian.PutUint32(table[i:], 16)
+				}
+				want = uint64(68)
+			}
+			// One DWARF 5 compile unit, one abbreviation, no children.
+			abbrev := []byte{1, 0x11, 0, attr, form, baseAttr, 0x17, 0, 0, 0}
+			info := []byte{14, 0, 0, 0, 5, 0, 1, 4, 0, 0, 0, 0, 1, index, 0, 0, 0, 0}
+			binary.LittleEndian.PutUint32(info[14:], base)
+			d, err := dwarf.New(abbrev, nil, nil, info, nil, nil, nil, []byte("name\x00"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := d.AddSection(section, table); err != nil {
+				t.Fatal(err)
+			}
+			e, err := d.Reader().Next()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := e.Val(dwarf.Attr(attr)); got != want {
+				t.Fatalf("indexed attribute = %v, want %v", got, want)
+			}
+		})
+	}
+}
