index 00000000..530cc040
--- /dev/null
+++ b/src/internal/ohos/timezone_openharmony_nocgo.go
@@ -0,0 +1,93 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build openharmony
+
+package ohos
+
+import (
+	"syscall"
+	_ "unsafe" // go:linkname
+)
+
+//go:linkname runtimeTimezone runtime.openharmonyTimezone
+func runtimeTimezone(buf *byte, size int) int32
+
+// The system utility is a fallback for shell binaries without libc. Never run a
+// shell or accept an executable from PATH. App sandboxes can supply TZ through
+// their application context when process creation is unavailable.
+func systemTimezone() string {
+	var value [128]byte
+	if n := runtimeTimezone(&value[0], len(value)); n > 0 && int(n) < len(value) {
+		return string(value[:n])
+	}
+	var pipe [2]int
+	if syscall.Pipe2(pipe[:], syscall.O_CLOEXEC|syscall.O_NONBLOCK) != nil {
+		return ""
+	}
+	defer syscall.Close(pipe[0])
+	pid, err := syscall.ForkExec("/bin/param", []string{"param", "get", "persist.time.timezone"},
+		&syscall.ProcAttr{Env: syscall.Environ(), Files: []uintptr{^uintptr(0), uintptr(pipe[1]), ^uintptr(0)}})
+	syscall.Close(pipe[1])
+	if err != nil {
+		return ""
+	}
+	ep, err := syscall.EpollCreate1(syscall.EPOLL_CLOEXEC)
+	if err != nil {
+		syscall.Kill(pid, syscall.SIGKILL)
+		syscall.Wait4(pid, nil, 0, nil)
+		return ""
+	}
+	defer syscall.Close(ep)
+	if syscall.EpollCtl(ep, syscall.EPOLL_CTL_ADD, pipe[0], &syscall.EpollEvent{Events: syscall.EPOLLIN | syscall.EPOLLHUP, Fd: int32(pipe[0])}) != nil {
+		syscall.Kill(pid, syscall.SIGKILL)
+		syscall.Wait4(pid, nil, 0, nil)
+		return ""
+	}
+	var b [128]byte
+	n := 0
+	var status syscall.WaitStatus
+	done := false
+	eof := false
+	for tries := 0; tries < 20; tries++ {
+		var events [1]syscall.EpollEvent
+		if _, e := syscall.EpollWait(ep, events[:], 50); e != nil && e != syscall.EINTR {
+			break
+		}
+		m, e := -1, error(nil)
+		if !eof {
+			m, e = syscall.Read(pipe[0], b[n:])
+		}
+		if m > 0 {
+			n += m
+		}
+		if n == len(b) {
+			break
+		}
+		if m == 0 && e == nil {
+			eof = true
+			syscall.EpollCtl(ep, syscall.EPOLL_CTL_DEL, pipe[0], nil)
+		}
+		w, _ := syscall.Wait4(pid, &status, syscall.WNOHANG, nil)
+		if w == pid {
+			done = true
+			break
+		}
+	}
+	if !done {
+		syscall.Kill(pid, syscall.SIGKILL)
+		syscall.Wait4(pid, &status, 0, nil)
+	}
+	if !done || !status.Exited() || status.ExitStatus() != 0 {
+		return ""
+	}
+	start := 0
+	for start < n && (b[start] == ' ' || b[start] == '\n' || b[start] == '\r' || b[start] == '\t') {
+		start++
+	}
+	for n > start && (b[n-1] == ' ' || b[n-1] == '\n' || b[n-1] == '\r' || b[n-1] == '\t') {
+		n--
+	}
+	return string(b[start:n])
+}
