+
+package net
+
+/*
+#include <sys/socket.h>
+*/
+import "C"
+
+func init() {
+	// OHOS libc applies application network selection and VPN protection hooks
+	// at socket creation. A raw syscall would skip that system policy.
+	socketFunc = func(family, typ, protocol int) (int, error) {
