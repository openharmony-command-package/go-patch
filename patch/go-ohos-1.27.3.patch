@@ -0,0 +1,53 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package time_test
+
+import (
+	"bytes"
+	"encoding/binary"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestOHOSPackedTzdata(t *testing.T) {
+	const header, entry = 24, 48
+	data := make([]byte, header+entry+4)
+	copy(data, "tzdata2026a")
+	binary.BigEndian.PutUint32(data[12:], header)
+	binary.BigEndian.PutUint32(data[16:], header+entry)
+	copy(data[header:], "Asia/Shanghai")
+	binary.BigEndian.PutUint32(data[header+44:], 4)
+	copy(data[header+entry:], "TZif")
+	file := filepath.Join(t.TempDir(), "tzdata")
+	write := func() {
+		t.Helper()
+		if err := os.WriteFile(file, data, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write()
+	got, err := time.OHOSLoadTzinfoForTest(file, "Asia/Shanghai")
+	if err != nil || !bytes.Equal(got, []byte("TZif")) {
+		t.Fatalf("exact lookup: %q, %v", got, err)
+	}
+	if _, err := time.OHOSLoadTzinfoForTest(file, "Asia/ShanghaiX"); err == nil {
+		t.Fatal("matched a longer name")
+	}
+	if _, err := time.OHOSLoadTzinfoForTest(file, "Asia/Shanghai"[:8]); err == nil {
+		t.Fatal("matched a name prefix")
+	}
+	binary.BigEndian.PutUint32(data[header+44:], ^uint32(0))
+	write()
+	if _, err := time.OHOSLoadTzinfoForTest(file, "Asia/Shanghai"); err == nil {
+		t.Fatal("accepted an oversized zone")
+	}
+	binary.BigEndian.PutUint32(data[16:], header-1)
+	write()
+	if _, err := time.OHOSLoadTzinfoForTest(file, "Asia/Shanghai"); err == nil {
+		t.Fatal("accepted a reversed index")
+	}
+}
