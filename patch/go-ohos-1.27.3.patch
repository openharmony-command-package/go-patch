--- /dev/null
+++ b/src/runtime/testdata/testprogcgo/sigaction_openharmony.c
@@ -0,0 +1,18 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// OHOS libc preloads the DFX crash handler and installs it as the user
+// SIGSEGV action. Go correctly forwards synchronous C faults to that prior
+// handler, whereas these helpers test Go's own C traceback/symbolizer.
+// Restore the default before Go starts and before the helper constructors
+// that deliberately install handlers to test signal forwarding.
+#include <signal.h>
+
+__attribute__((constructor(101))) static void reset_ohos_crash_handler(void)
+{
+    struct sigaction action = {0};
+    action.sa_handler = SIG_DFL;
+    sigemptyset(&action.sa_mask);
+    sigaction(SIGSEGV, &action, 0);
+}
