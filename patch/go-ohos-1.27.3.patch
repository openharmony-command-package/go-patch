+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package ohossign
+
+import (
+	"bytes"
+	"encoding/binary"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestMain(m *testing.M) {
+	if os.Getenv("GO_OHOS_SIGN_HELPER") == "1" {
+		if len(os.Args) != 8 || os.Args[1] != "sign" || os.Args[2] != "-inFile" || os.Args[4] != "-outFile" || os.Args[3] != os.Args[5] || os.Args[6] != "-selfSign" || os.Args[7] != "1" {
+			os.Exit(9)
+		}
+		if os.Getenv("GO_OHOS_SIGN_FAIL") == "1" {
+			os.Exit(7)
+		}
+		f, err := os.OpenFile(os.Args[3], os.O_APPEND|os.O_WRONLY, 0)
+		if err != nil {
+			os.Exit(8)
+		}
+		f.WriteString("signed")
+		f.Close()
+		os.Chmod(os.Args[3], 0600)
+		os.Exit(0)
+	}
+	os.Exit(m.Run())
+}
+
+func TestSign(t *testing.T) {
+	t.Setenv("GO_OHOS_SIGN_HELPER", "1")
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, class := range []byte{1, 2} {
+		for _, endian := range []byte{1, 2} {
+			for _, typ := range []uint16{1, 2, 3} {
+				var h [64]byte
+				copy(h[:], "\x7fELF")
+				h[4], h[5] = class, endian
+				var order binary.ByteOrder = binary.LittleEndian
+				if endian == 2 {
+					order = binary.BigEndian
+				}
+				order.PutUint16(h[16:], typ)
+				path := filepath.Join(t.TempDir(), "an ELF image")
+				if err := os.WriteFile(path, h[:], 0755); err != nil {
+					t.Fatal(err)
+				}
+				if err := sign(path, exe); err != nil {
+					t.Fatal(err)
+				}
+				b, _ := os.ReadFile(path)
+				if bytes.HasSuffix(b, []byte("signed")) != (typ == 2 || typ == 3) {
+					t.Fatalf("class=%d endian=%d type=%d: wrong signing decision", class, endian, typ)
+				}
+				info, _ := os.Stat(path)
+				if info.Mode().Perm() != 0755 {
+					t.Fatalf("permissions changed: %v", info.Mode())
+				}
+			}
+		}
+	}
+	for _, data := range [][]byte{nil, []byte("!<arch>\n"), make([]byte, 100)} {
+		path := filepath.Join(t.TempDir(), "input")
+		os.WriteFile(path, data, 0644)
+		if err := sign(path, "missing-signer"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var h [64]byte
+	copy(h[:], "\x7fELF")
+	h[4], h[5], h[16] = 2, 1, 2
+	path := filepath.Join(t.TempDir(), "executable")
+	os.WriteFile(path, h[:], 0755)
+	t.Setenv("GO_OHOS_SIGN_FAIL", "1")
+	if err := sign(path, exe); err == nil || !strings.Contains(err.Error(), "exit status 7") {
+		t.Fatalf("signer failure was not propagated: %v", err)
+	}
+}
