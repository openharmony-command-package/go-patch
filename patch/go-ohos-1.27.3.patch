index 00000000..058a4c8e
--- /dev/null
+++ b/src/cmd/internal/ohossign/sign.go
@@ -0,0 +1,52 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Package ohossign signs finalized ELF images on OpenHarmony hosts.
+package ohossign
+
+import (
+	"encoding/binary"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+)
+
+func sign(path, tool string) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	var h [18]byte
+	_, err = io.ReadFull(f, h[:])
+	info, statErr := f.Stat()
+	f.Close()
+	if err == io.EOF || err == io.ErrUnexpectedEOF {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if string(h[:4]) != "\x7fELF" {
+		return nil
+	}
+	var order binary.ByteOrder = binary.LittleEndian
+	if h[5] == 2 {
+		order = binary.BigEndian
+	}
+	typ := order.Uint16(h[16:])
+	if typ != 2 && typ != 3 {
+		return nil
+	} // ET_REL and archives must stay untouched.
+	if statErr != nil {
+		return statErr
+	}
+	out, err := exec.Command(tool, "sign", "-inFile", path, "-outFile", path, "-selfSign", "1").CombinedOutput()
+	// The signer may replace the file, so restore its original permissions.
+	modeErr := os.Chmod(path, info.Mode().Perm())
+	if err != nil {
+		return fmt.Errorf("OHOS self-sign %s: %w: %s", path, err, out)
+	}
+	return modeErr
+}
