+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+#include "textflag.h"
+
+// Call libc through the same signal-chain-aware bridge as the other OHOS
+// architectures. The caller has already selected a system or signal stack.
+TEXT runtime·callCgoSigaction(SB),NOSPLIT,$0-16
+	MOVW	sig+0(FP), R0
+	MOVW	new+4(FP), R1
+	MOVW	old+8(FP), R2
+	MOVW	_cgo_sigaction(SB), R3
+	MOVW	R13, R4
+	SUB	$32, R13
+	BIC	$7, R13 // ARM C ABI requires an eight-byte-aligned stack.
+	MOVW	R4, 12(R13)
+	BL	(R3)
+	MOVW	12(R13), R4
+	MOVW	R4, R13
+	MOVW	R0, ret+12(FP)
+	RET
diff --git a/src/runtime/testdata/testprogcgo/exec_openharmony.go b/src/runtime/testdata/testprogcgo/exec_openharmony.go
new file mode 100644
index 00000000..2f28b0ec
--- /dev/null
+++ b/src/runtime/testdata/testprogcgo/exec_openharmony.go
@@ -0,0 +1,66 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package main
+
+/*
+#include <signal.h>
+#include <stdint.h>
+static uintptr_t exec_segv_handler(void) {
+    struct sigaction action = {0};
+    if (sigaction(SIGSEGV, NULL, &action) != 0) return 0;
+    return (uintptr_t)action.sa_handler;
+}
+*/
+import "C"
+
+import (
+	"fmt"
+	"os/exec"
+	"runtime"
+	"sync"
+)
+
+func init() { register("ConcurrentExecSignals", concurrentExecSignals) }
+
+func concurrentExecSignals() {
+	runtime.GOMAXPROCS(4)
+	shell, err := exec.LookPath("sh")
+	if err != nil {
+		panic(err)
+	}
+	initial := C.exec_segv_handler()
+	if initial == 0 {
+		panic("missing SIGSEGV handler before exec")
+	}
+	var workers sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for j := 0; j < 64; j++ {
+				if err := exec.Command(shell, "-c", "exit 0").Run(); err != nil {
+					panic(err)
+				}
+				if current := C.exec_segv_handler(); current != initial {
+					panic(fmt.Sprintf("concurrent exec changed parent SIGSEGV handler: %#x -> %#x", initial, current))
+				}
+				execRecoverFault()
+			}
+		}()
+	}
+	workers.Wait()
+	fmt.Println("OK")
+}
+
+//go:noinline
+func execRecoverFault() {
+	defer func() {
+		if recover() == nil {
+			panic("fault did not panic")
+		}
+	}()
+	var ptr *int
+	_ = *ptr
+}
