diff --git a/src/net/interface_openharmony.go b/src/net/interface_openharmony.go
new file mode 100644
index 00000000..581aecf5
--- /dev/null
+++ b/src/net/interface_openharmony.go
@@ -0,0 +1,103 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build openharmony && cgo
+
+package net
+
+/*
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <string.h>
+#include <unistd.h>
+
+static void go_ohos_ifinfo(const char *name, int *mtu, unsigned char *mac) {
+    int fd = socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (fd < 0) return;
+    struct ifreq req = {0};
+    strncpy(req.ifr_name, name, IFNAMSIZ - 1);
+    if (ioctl(fd, SIOCGIFMTU, &req) == 0) *mtu = req.ifr_mtu;
+    if (ioctl(fd, SIOCGIFHWADDR, &req) == 0) memcpy(mac, req.ifr_hwaddr.sa_data, 6);
+    close(fd);
+}
+*/
+import "C"
+
+import (
+	"os"
+	"syscall"
+	"unsafe"
+)
+
+// OHOS applications may not open NETLINK_ROUTE sockets. libc routes these
+// requests through the system network service. Keep the Linux implementation
+// for builds that explicitly disable cgo.
+func interfaceTable(ifindex int) ([]Interface, error) {
+	var list *C.struct_ifaddrs
+	if rc, err := C.getifaddrs(&list); rc != 0 {
+		return nil, os.NewSyscallError("getifaddrs", err)
+	}
+	defer C.freeifaddrs(list)
+	var result []Interface
+	seen := make(map[int]bool)
+	for r := list; r != nil; r = r.ifa_next {
+		index := int(C.if_nametoindex(r.ifa_name))
+		if index == 0 || seen[index] || ifindex != 0 && index != ifindex {
+			continue
+		}
+		seen[index] = true
+		var mtu C.int
+		var mac [6]C.uchar
+		C.go_ohos_ifinfo(r.ifa_name, &mtu, &mac[0])
+		ifi := Interface{Index: index, Name: C.GoString(r.ifa_name), MTU: int(mtu), Flags: linkFlags(uint32(r.ifa_flags))}
+		for _, b := range mac {
+			if b != 0 {
+				ifi.HardwareAddr = make(HardwareAddr, len(mac))
+				for j := range mac {
+					ifi.HardwareAddr[j] = byte(mac[j])
+				}
+				break
+			}
+		}
+		result = append(result, ifi)
+	}
+	return result, nil
+}
+
+func interfaceAddrTable(ifi *Interface) ([]Addr, error) {
+	var list *C.struct_ifaddrs
+	if rc, err := C.getifaddrs(&list); rc != 0 {
+		return nil, os.NewSyscallError("getifaddrs", err)
+	}
+	defer C.freeifaddrs(list)
+	var result []Addr
+	for r := list; r != nil; r = r.ifa_next {
+		if r.ifa_addr == nil || r.ifa_netmask == nil {
+			continue
+		}
+		if ifi != nil && int(C.if_nametoindex(r.ifa_name)) != ifi.Index {
+			continue
+		}
+		var ip IP
+		var mask IPMask
+		switch r.ifa_addr.sa_family {
+		case C.AF_INET:
+			sa := (*syscall.RawSockaddrInet4)(unsafe.Pointer(r.ifa_addr))
+			ma := (*syscall.RawSockaddrInet4)(unsafe.Pointer(r.ifa_netmask))
+			ip = IPv4(sa.Addr[0], sa.Addr[1], sa.Addr[2], sa.Addr[3])
+			mask = append(IPMask(nil), ma.Addr[:]...)
+		case C.AF_INET6:
+			sa := (*syscall.RawSockaddrInet6)(unsafe.Pointer(r.ifa_addr))
+			ma := (*syscall.RawSockaddrInet6)(unsafe.Pointer(r.ifa_netmask))
+			ip = append(IP(nil), sa.Addr[:]...)
+			mask = append(IPMask(nil), ma.Addr[:]...)
+		default:
+			continue
+		}
+		result = append(result, &IPNet{IP: ip, Mask: mask})
+	}
+	return result, nil
+}
