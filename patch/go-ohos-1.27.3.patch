index 00000000..de9a0c8f
--- /dev/null
+++ b/src/os/openharmony/openharmony.go
@@ -0,0 +1,85 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Package openharmony configures Go libraries from an OHOS application Context.
+// Call Configure before starting application goroutines. Paths come from the
+// embedding application; no package name or private directory is guessed.
+package openharmony
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+)
+
+// Config contains directories obtained from the current application's Context.
+// Timezone is optional; when empty, time.Local uses system timezone discovery.
+// Set it before the first use of time.Local, whose initialization is cached.
+type Config struct {
+	FilesDir string
+	CacheDir string
+	TempDir  string
+	Timezone string
+	// TrustedCertDirs are additional CA directories explicitly approved by the
+	// application (for example a directory returned by Certificate Manager).
+	// User certificate stores are never recursively imported without consent.
+	TrustedCertDirs []string
+}
+
+// Configure validates all directories before setting HOME, XDG_CONFIG_HOME,
+// XDG_CACHE_HOME and TMPDIR. It never creates or broadens access to directories.
+// A process embedding several Go clients should configure one shared Context.
+func Configure(c Config) error {
+	if !runtime.IsOpenharmony {
+		return errors.New("openharmony: unsupported operating system")
+	}
+	for _, path := range []string{c.FilesDir, c.CacheDir, c.TempDir} {
+		if path == "" || !filepath.IsAbs(path) || strings.IndexByte(path, 0) >= 0 {
+			return errors.New("openharmony: Context directories must be absolute paths")
+		}
+		info, err := os.Stat(path)
+		if err != nil {
+			return err
+		}
+		if !info.IsDir() {
+			return errors.New("openharmony: Context path is not a directory: " + path)
+		}
+	}
+	if strings.IndexByte(c.Timezone, 0) >= 0 {
+		return errors.New("openharmony: invalid timezone")
+	}
+	for _, path := range c.TrustedCertDirs {
+		if !filepath.IsAbs(path) || strings.ContainsAny(path, "\x00:") {
+			return errors.New("openharmony: invalid CA directory")
+		}
+		info, err := os.Stat(path)
+		if err != nil {
+			return err
+		}
+		if !info.IsDir() {
+			return errors.New("openharmony: CA path is not a directory")
+		}
+	}
+	vars := [][2]string{
+		{"HOME", filepath.Clean(c.FilesDir)},
+		{"XDG_CONFIG_HOME", filepath.Join(c.FilesDir, ".config")},
+		{"XDG_CACHE_HOME", filepath.Clean(c.CacheDir)},
+		{"TMPDIR", filepath.Clean(c.TempDir)},
+	}
+	if c.Timezone != "" {
+		vars = append(vars, [2]string{"TZ", c.Timezone})
+	}
+	if len(c.TrustedCertDirs) != 0 {
+		dirs := append([]string{"/etc/security/certificates", "/system/etc/security/certificates"}, c.TrustedCertDirs...)
+		vars = append(vars, [2]string{"SSL_CERT_DIR", strings.Join(dirs, ":")})
+	}
+	for _, v := range vars {
+		if err := os.Setenv(v[0], v[1]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
