diff --git a/src/internal/runtime/hilog/hilog_openharmony.go b/src/internal/runtime/hilog/hilog_openharmony.go
new file mode 100644
index 00000000..5f1249fb
--- /dev/null
+++ b/src/internal/runtime/hilog/hilog_openharmony.go
@@ -0,0 +1,247 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build openharmony
+
+// Package hilog implements the bounded, nonblocking OHOS hilogd wire transport.
+// It is usable from runtime crash paths without cgo, allocation, or Go locks.
+package hilog
+
+import (
+	"internal/runtime/atomic"
+	"unsafe"
+)
+
+var gate atomic.Uint32
+var disabled atomic.Bool
+var fd int32 = -1
+var packetWords [1024]uint32
+var packet = (*[4096]byte)(unsafe.Pointer(&packetWords[0]))
+var streams [3]struct {
+	data [4000]byte
+	n    int
+}
+var address = struct {
+	family uint16
+	path   [108]byte
+}{family: 1, path: [108]byte{'/', 'd', 'e', 'v', '/', 'u', 'n', 'i', 'x', '/', 's', 'o', 'c', 'k', 'e', 't', '/', 'h', 'i', 'l', 'o', 'g', 'I', 'n', 'p', 'u', 't'}}
+
+// SetEnabled controls automatic stdout/stderr mirroring. Explicit Write calls
+// remain available. Missing or congested hilogd never changes stdio semantics.
+func SetEnabled(enabled bool) { disabled.Store(!enabled) }
+
+// The packet, socket address and clock scratch are protected by gate. Keep
+// each crash-path frame small even under -gcflags=all="-N -l".
+var clockScratch [2]uintptr
+var vector = struct {
+	base   unsafe.Pointer
+	length uintptr
+}{base: unsafe.Pointer(&packetWords[0])}
+var message = struct {
+	name       unsafe.Pointer
+	nameLen    uint32
+	iov        unsafe.Pointer
+	iovLen     uintptr
+	control    unsafe.Pointer
+	controlLen uintptr
+	flags      int32
+}{iov: unsafe.Pointer(&vector), iovLen: 1}
+
+// raw3 is an allocation-free, NOSPLIT syscall leaf. The narrower ABI keeps
+// signal-handler stack use bounded even when the compiler disables optimization.
+func raw3(trap, a1, a2, a3 uintptr) (result, errno uintptr)
+func raw0(trap uintptr) uintptr
+func socketFD() int32
+
+//go:nosplit
+func put8(i int, v byte) { *(*byte)(unsafe.Add(unsafe.Pointer(&packet[0]), i)) = v }
+
+// All supported OHOS ABIs are little endian. Header stores are aligned by
+// packetWords and the protocol's fixed 16/32-bit offsets.
+//
+//go:nosplit
+func put16(i int, v uint16) { *(*uint16)(unsafe.Add(unsafe.Pointer(&packetWords[0]), i)) = v }
+
+//go:nosplit
+func put32(i int, v uint32) { *(*uint32)(unsafe.Add(unsafe.Pointer(&packetWords[0]), i)) = v }
+
+//go:nosplit
+func connectSocket() bool {
+	if fd >= 0 {
+		return true
+	}
+	fd = socketFD()
+	if fd < 0 {
+		return false
+	}
+	r := uintptr(fd)
+	var e uintptr
+	_, e = raw3(sysConnect, r, uintptr(unsafe.Pointer(&address)), 30)
+	if e != 0 {
+		raw3(sysClose, uintptr(fd), 0, 0)
+		fd = -1
+		return false
+	}
+	return true
+}
+
+//go:nosplit
+func processID(trap uintptr) uint32 {
+	return uint32(raw0(trap))
+}
+
+//go:nosplit
+func header(level uint8, domain uint32, tagLen int) {
+	raw3(sysClockGettime, 0, uintptr(unsafe.Pointer(&clockScratch)), 0)
+	put32(4, uint32(clockScratch[0]))
+	put32(8, uint32(clockScratch[1]))
+	raw3(sysClockGettime, 1, uintptr(unsafe.Pointer(&clockScratch)), 0)
+	put32(12, uint32(clockScratch[0]))
+	put32(16, processID(sysGetpid))
+	put32(20, processID(sysGettid))
+	put32(24, domain)
+	put16(2, uint16(level)<<7|uint16(tagLen+1)<<10)
+}
+
+//go:nosplit
+func transmit(n int) bool {
+	vector.length = uintptr(n)
+	r, e := raw3(sysSendmsg, uintptr(fd), uintptr(unsafe.Pointer(&message)), 0x40|0x4000)
+	if e != 0 && e != 11 && e != 4 {
+		raw3(sysClose, uintptr(fd), 0, 0)
+		fd = -1
+	}
+	return e == 0 && r == uintptr(n)
+}
+
+type logRecord struct {
+	level  uint8
+	domain uint32
+	tag    string
+	text   []byte
+}
+
+// send is called with gate held. HilogMsg is a packed 28-byte header shared by
+// all three ABIs. LOG_APP/version 0 are used; preformatted stdio text is public.
+// The caller bounds tag to 31 bytes and text to 4000 bytes. With terminators,
+// the largest packet is 4061 bytes, below packet's fixed 4096-byte capacity.
+//
+//go:nosplit
+func send(record *logRecord) bool {
+	if len(record.tag) > 31 || len(record.text) > 4000 || !connectSocket() {
+		return false
+	}
+	header(record.level, record.domain, len(record.tag))
+	n := 28
+	for i := 0; i < len(record.tag); i++ {
+		put8(n, *(*byte)(unsafe.Add(unsafe.Pointer(unsafe.StringData(record.tag)), i)))
+		n++
+	}
+	put8(n, 0)
+	n++
+	for _, c := range record.text {
+		if c == 0 {
+			c = ' '
+		}
+		put8(n, c)
+		n++
+	}
+	put8(n, 0)
+	n++
+	put16(0, uint16(n))
+	return transmit(n)
+}
+
+// Write emits preformatted text, splitting long records without truncation.
+// It deliberately fails rather than waiting behind a reentrant crash logger.
+func Write(level uint8, domain uint32, tag string, text []byte) bool {
+	if level < 3 || level > 7 || domain > 0xffff || len(tag) == 0 || len(tag) > 31 {
+		return false
+	}
+	for i := range tag {
+		if tag[i] == 0 {
+			return false
+		}
+	}
+	if !gate.CompareAndSwap(0, 1) {
+		return false
+	}
+	ok := true
+	for len(text) > 0 {
+		n := len(text)
+		if n > 4000 {
+			n = 4000
+		}
+		record := logRecord{level, domain, tag, text[:n]}
+		if !send(&record) {
+			ok = false
+			break
+		}
+		text = text[n:]
+	}
+	gate.Store(0)
+	return ok
+}
+
+// WriteStream mirrors ordinary Go stdout/stderr. Runtime signal and crash
+// paths use the shallower WriteRuntime entry below.
+func WriteStream(stream int, data []byte) {
+	if stream < 1 || stream > 2 || disabled.Load() || !gate.CompareAndSwap(0, 1) {
+		return
+	}
+	b := &streams[stream]
+	level := uint8(4)
+	if stream == 2 {
+		level = 6
+	}
+	for _, c := range data {
+		if c != '\n' {
+			if c == 0 {
+				c = ' '
+			}
+			b.data[b.n] = c
+			b.n++
+		}
+		if c == '\n' || b.n == len(b.data) {
+			record := logRecord{level, 0, "Go", b.data[:b.n]}
+			send(&record)
+			b.n = 0
+		}
+	}
+	gate.Store(0)
+}
+
+// WriteRuntime shares stderr buffering, but avoids the general record encoder
+// call chain. This path must fit the runtime's NOSPLIT budget with -N -l too.
+//
+//go:nosplit
+func WriteRuntime(data []byte) {
+	if disabled.Load() || !gate.CompareAndSwap(0, 1) {
+		return
+	}
+	b := &streams[2]
+	for _, c := range data {
+		if c != '\n' {
+			if c == 0 {
+				c = ' '
+			}
+			b.data[b.n] = c
+			b.n++
+		}
+		if c == '\n' || b.n == len(b.data) {
+			if connectSocket() {
+				header(6, 0, 2)
+				packet[28] = 'G'
+				packet[29] = 'o'
+				packet[30] = 0
+				copy(packet[31:], b.data[:b.n])
+				packet[31+b.n] = 0
+				put16(0, uint16(32+b.n))
+				transmit(32 + b.n)
+			}
+			b.n = 0
+		}
+	}
+	gate.Store(0)
+}
